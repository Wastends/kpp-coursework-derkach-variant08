<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Water quality server</display-name>

    <servlet>
        <servlet-name>ObservationPointServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.ObservationPointServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>WaterSampleServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.WaterSampleServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>MeasurementServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.MeasurementServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>SampleCheckServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.SampleCheckServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ObservationPointServlet</servlet-name>
        <url-pattern>/points</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>WaterSampleServlet</servlet-name>
        <url-pattern>/samples</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>MeasurementServlet</servlet-name>
        <url-pattern>/measurements</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>SampleCheckServlet</servlet-name>
        <url-pattern>/checks</url-pattern>
    </servlet-mapping>
</web-app>
